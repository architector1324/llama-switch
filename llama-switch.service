[Unit]
Description=Llama Switch Service
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/AI/LLama Switch
ExecStart=/usr/bin/python3 server.py --config %h/.config/llama-switch/config.yaml --watch \
    --tls-cert %h/.config/llama-switch/tls-cert.pem \
    --tls-key %h/.config/llama-switch/tls-key.pem
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
